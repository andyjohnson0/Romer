<resources>

	<!-- Splash screen theme-->
	<style name="AppTheme.Starting" parent="Theme.SplashScreen">
		<item name="windowSplashScreenBackground">@color/backgroundOpaque</item>
		<item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>>
		<item name="postSplashScreenTheme">@style/AppTheme</item>
	</style>
	
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
		<item name="windowActionModeOverlay">true</item>  <!-- Ensure that actionbar overlays toolbar instead of pushing it down -->
    </style>

	<!-- Settings theme -->
	<style name="AppTheme.Settings" parent="AppTheme">
		<item name="colorAccent">@color/colorAccent</item>		<!-- Category titles -->
	</style>

	<!-- Dialog theme -->
	<style name="AppTheme.Dialog" parent="Theme.MaterialComponents.DayNight.Dialog">
		<item name="colorPrimary">@color/colorPrimary</item>
		<item name="colorPrimaryDark">@color/colorPrimaryDark</item>
		<item name="colorAccent">@color/colorAccent</item>
	</style>

	<!-- Alert dialog theme. Note: doesn't inherit from AppTheme.Dialog. -->
	<style name="AppTheme.Dialog.Alert" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
		<item name="buttonBarNegativeButtonStyle">@style/NegativeButtonStyle</item>
		<item name="buttonBarPositiveButtonStyle">@style/PositiveButtonStyle</item>
	</style>
	<style name="NegativeButtonStyle" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
		<item name="android:textColor">?android:attr/textColorPrimary</item>
	</style>
	<style name="PositiveButtonStyle" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
		<item name="android:textColor">@color/colorAccent</item>
	</style>

    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.MaterialComponents.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.MaterialComponents.Light" />

	<!-- Tab layouts -->
	<style name="TabLayoutStyle" parent="Widget.Design.TabLayout">
		<item name="tabBackground">?attr/colorPrimary</item>
		<item name="tabIndicatorColor">@color/colorAccent</item>
		<item name="tabSelectedTextColor">@color/colorAccent</item>
		<item name="tabTextAppearance">@style/TabTextAppearanceStyle</item>
	</style>
	<style name="TabTextAppearanceStyle" parent="TextAppearance.Design.Tab">
		<item name="android:textColor">?android:attr/textColorSecondaryInverse</item>
		<item name="android:textSize">18sp</item> <!-- 14=sml,18=med,22=lge -->
		<item name="textAllCaps">false</item>
		<item name="android:textAllCaps">false</item>
	</style>



</resources>
