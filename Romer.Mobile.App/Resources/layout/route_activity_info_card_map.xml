<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/marginSizeMedium"
    card_view:cardElevation="4dp"
    card_view:cardCornerRadius="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_margin="@dimen/marginSizeMedium">
        <TextView
            android:id="@+id/cardHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@android:style/TextAppearance.Large"
		    android:textStyle="bold"/>
	    <Space
		    android:layout_width="match_parent"
		    android:layout_height="@dimen/marginSizeLarge"/>
        <Kilsten.Android.Controls.ZoomFrame
            android:id="@+id/zoomFrame"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <Romer.Mobile.App.MapZoomLayout
                android:id="@+id/zoomLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:debugInfoShow="false"
                android:background="@color/mapGreen">
                <Romer.Mobile.App.RouteMapView
                    android:id="@+id/chart"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/mapGreen"
                    app:routeStrokeColor="@android:color/black"
                    app:routeStrokeWidth="2"
                    app:waypointMarkerColor="@color/colorAccent"
                    app:waypointMarkerDiameter="24"
                    app:showWaypointNumber="true"
                    app:showWaypointLabel="true"
                    app:waypointLabelColor="@android:color/black"
                    app:waypointLabelMaxLength="10"
                    />
            </Romer.Mobile.App.MapZoomLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_gravity="bottom|right"
                android:clickable="false">
                <ImageButton
                    android:id="@+id/zoomInBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/marginSizeLarge"
                    android:tooltipText="@string/zoomIn"
                    android:contentDescription="@string/zoomIn"
                    android:src="@drawable/ic_zoom_in"
                    android:background="@android:color/transparent"/>
                <ImageButton
                    android:id="@+id/zoomOutBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/marginSizeLarge"
                    android:tooltipText="@string/zoomOut"
                    android:contentDescription="@string/zoomOut"
                    android:src="@drawable/ic_zoom_out"
                    android:background="@android:color/transparent"/>
                <ImageButton
                    android:id="@+id/zoomResetBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/marginSizeLarge"
                    android:tooltipText="@string/zoomReset"
                    android:contentDescription="@string/zoomReset"
                    android:src="@drawable/ic_zoom_out_map"
                    android:background="@android:color/transparent"/>
            </LinearLayout>
        </Kilsten.Android.Controls.ZoomFrame>
    </LinearLayout>
	
</androidx.cardview.widget.CardView>
