<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:paddingBottom="@dimen/listBottomPadding"
	android:background="@color/backgroundOpaque">
	<TextView
		android:id="@+id/headerTxt"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="center_horizontal"
		android:paddingTop="@dimen/listHeaderTopPadding"
		android:paddingBottom="@dimen/listHeaderBottomPadding"
		android:textSize="@dimen/listHeaderTextSize"
		android:textStyle="bold"/>
    <androidx.wear.widget.WearableRecyclerView
        android:id="@+id/waypoints_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:scrollbars="vertical"/>
</LinearLayout>
