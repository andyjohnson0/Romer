<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:boxedEdges="all"
    android:background="@color/backgroundOpaque"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <Romer.CommonLib.CompassView
        android:id="@+id/compassVw"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/backgroundTransparent"
        app:bezelColor="?android:attr/textColorPrimary"
        app:accentColor="?attr/colorAccent"/>

    <include layout="@layout/main_activity_display"/>

</FrameLayout>
