<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="@dimen/marginSizeMedium"
    android:paddingLeft="@dimen/listItemSidePadding"
	android:paddingRight="@dimen/listItemSidePadding">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
		android:layout_weight="1"
        android:orientation="vertical"
        android:layout_gravity="left"
        android:paddingRight="@dimen/marginSizeMedium"
        android:paddingBottom="@dimen/marginSizeSmall">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/gridRef"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="left"
                android:layout_weight="1"
                style="@android:style/TextAppearance.Medium"
                android:textStyle="bold"
                android:baselineAligned="false"/>
            <TextView
                android:id="@+id/altitude"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="right"
                style="@android:style/TextAppearance.Medium"
                android:baselineAligned="false"/>
        </LinearLayout>
        <TextView
            android:id="@+id/label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@android:style/TextAppearance.Medium"
            android:layout_gravity="left"
            android:baselineAligned="false"/>
    </LinearLayout>
    <CheckBox
        android:id="@+id/check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
		android:layout_gravity="center_vertical"/>
</LinearLayout>
