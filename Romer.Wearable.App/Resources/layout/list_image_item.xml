<?xml version="1.0" encoding="utf-8"?>

<!-- Use this for a menu item that contains an image (such as a flag) -->

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="@dimen/marginSizeMedium"
    android:paddingLeft="@dimen/marginSizeMedium">
    <ImageView
        android:id="@+id/item_img"
        android:layout_width="@dimen/buttonSizeStd"
        android:layout_height="@dimen/buttonSizeStd"
        android:layout_gravity="center_vertical"
        android:scaleType="center"
        android:tint="?attr/appDayNightImageViewForegroundTint"
        android:tintMode="src_atop"/>
    <TextView
        android:id="@+id/item_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@android:style/TextAppearance.Medium"
        android:textColor="@color/enable_disable_text"
        android:paddingLeft="@dimen/marginSizeLarge"
        android:layout_gravity="center_vertical"
        android:baselineAligned="false"/>
</LinearLayout>
