<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android36.0</TargetFramework>
    <SupportedOSPlatformVersion>30</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>uk.andyjohnson.romer</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);XA4218</MSBuildWarningsAsMessages>
    <AssemblyName>Romer.Wearable.App</AssemblyName>
    <RootNamespace>Romer.Wearable.App</RootNamespace>
	<Nullable>enable</Nullable>
    <Authors>Andrew Johnson</Authors>
    <Product>Romer</Product>
    <Copyright>Copyright © Andrew Johnson</Copyright>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>
  <PropertyGroup>
    <RuntimeIdentifiers>android-arm;android-arm64;android-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <RuntimeIdentifiers>$(RuntimeIdentifiers);android-x86</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Xamarin.AndroidX.AppCompat" Version="1.8.0" />
    <PackageReference Include="Xamarin.AndroidX.ConstraintLayout" Version="2.2.2" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.2.0.3" />
    <PackageReference Include="Xamarin.AndroidX.Preference" Version="1.2.1.18" />
    <!-- Preference 1.2.1.18 pulls in Fragment.Ktx 1.8.x, whose FragmentKt class duplicates the one in Fragment 1.9 and breaks D8. -->
    <PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
    <PackageReference Include="Xamarin.AndroidX.Wear" Version="1.4.0.2" />
    <PackageReference Include="Xamarin.AndroidX.Wear.RemoteInteractions" Version="1.2.0.3" />
    <PackageReference Include="Xamarin.GooglePlayServices.Wearable" Version="120.0.1.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Romer.CommonLib\Romer.CommonLib.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Kilsten.Android">
      <HintPath>..\lib\Kilsten.Android.dll</HintPath>
    </Reference>
    <Reference Include="Kilsten.WearOS">
      <HintPath>..\lib\Kilsten.WearOS.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
